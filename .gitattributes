# Git LFS configuration for large files
# Model files
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
# Tokenizer files
*.model filter=lfs diff=lfs merge=lfs -text
*.vocab filter=lfs diff=lfs merge=lfs -text
*.sentencepiece filter=lfs diff=lfs merge=lfs -text
# Large text data files
tokenized_gpt.txt filter=lfs diff=lfs merge=lfs -text
gpt_data.txt filter=lfs diff=lfs merge=lfs -text
# Data files (if large)
*.en filter=lfs diff=lfs merge=lfs -text
*.vi filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
# Other common large file formats
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
